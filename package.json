{
  "name": "holiday-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A little home server for a whole lot of family fun.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build && vite build --config vite.runtime.config.js",
    "start": "node server/index.js",
    "install:app": "node scripts/install.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.10"
  }
}
