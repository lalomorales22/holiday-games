# All values stay on the home server. Do not commit a real .env file.
PORT=3000
HOLIDAY_FAMILY_NAME=The family
# Optional. Otherwise generated on first launch and printed in the terminal.
# HOLIDAY_HOST_PASSWORD=
# HOLIDAY_JOIN_CODE=
# Optional AI provider; without a key, the demo creator works.
# HOLIDAY_AI_KEY=
# HOLIDAY_AI_URL=https://api.openai.com/v1
# HOLIDAY_AI_MODEL=gpt-4o-mini
# For local Ollama: HOLIDAY_AI_URL=http://127.0.0.1:11434/v1
# HOLIDAY_AI_MODEL=llama3.2
# HOLIDAY_AI_KEY=ollama
